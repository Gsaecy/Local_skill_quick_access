{
	"name": "local-skill-quick-launch",
	"displayName": "本地skill快捷调用",
	"description": "可视化勾选管理本地 Copilot 技能：分类可改名/新建/拖动换组，勾选即默认激活，对话命中用途或触发词时自动调用。",
	"version": "0.4.1",
	"publisher": "honor-world",
	"license": "MIT",
	"icon": "icon.png",
	"engines": {
		"vscode": "^1.93.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"copilot",
		"skill",
		"skills",
		"chat",
		"prompt"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/Gsaecy/Local_skill_quick_access.git"
	},
	"activationEvents": [],
	"main": "./out/extension.js",
	"contributes": {
		"configuration": {
			"title": "本地skill快捷调用",
			"properties": {
				"skillQuickLaunch.autoDetect": {
					"type": "boolean",
					"default": true,
					"description": "自动检测对话中调用过的技能并勾选（读取本地 Copilot 会话记录，不联网不上传）"
				},
				"skillQuickLaunch.pollIntervalSeconds": {
					"type": "number",
					"default": 10,
					"minimum": 5,
					"description": "会话记录扫描间隔（秒）"
				},
				"skillQuickLaunch.activationMode": {
					"type": "string",
					"enum": [
						"route",
						"always"
					],
					"enumDescriptions": [
						"命中即调用：对话内容匹配技能用途或触发词时才读取该 SKILL.md（推荐，不干扰无关任务）",
						"每次对话预读全部：旧版语义，新对话先读取所有已激活技能的 SKILL.md"
					],
					"default": "route",
					"description": "激活后的调用方式"
				}
			}
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "skillsManager",
					"title": "本地skill快捷调用",
					"icon": "media/activitybar.svg"
				}
			]
		},
		"views": {
			"skillsManager": [
				{
					"type": "webview",
					"id": "skillsManager.listView",
					"name": "技能列表"
				}
			]
		}
	},
	"scripts": {
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"package": "npx @vscode/vsce package"
	},
	"devDependencies": {
		"@types/node": "^20.11.0",
		"@types/vscode": "^1.93.0",
		"typescript": "^5.4.0",
		"@vscode/vsce": "^3.0.0"
	},
	"homepage": "https://github.com/Gsaecy/Local_skill_quick_access",
	"bugs": {
		"url": "https://github.com/Gsaecy/Local_skill_quick_access/issues"
	}
}
